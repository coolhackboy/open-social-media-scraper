# White-label settings. Copy to `.env.local` and edit. All values are optional.
# Never put an API key in a VITE_ variable: everything here is bundled into the public build.

# Name shown in the top bar, page title and Open Graph tags.
VITE_BRAND_NAME="Open Social Media Scraper"

# Absolute or /public-relative URL of a square logo (SVG/PNG). Defaults to the built-in mark.
VITE_BRAND_LOGO_URL=

# Accent color (any CSS color). Defaults to the built-in orange-red, hsl(8 92% 58%).
VITE_ACCENT=

# API base URL. Point this at your own SocQ-compatible gateway if you resell.
VITE_API_BASE=https://api.socq.ai

# Show the small "Powered by SocQ" link in the footer. Set to false to hide it.
VITE_SHOW_POWERED_BY=true

# Public URL of your deployment (used for absolute og:url / og:image). Defaults to the GitHub repo.
VITE_SITE_URL=
